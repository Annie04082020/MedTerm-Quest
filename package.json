{
  "name": "medterm-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:core": "node --experimental-strip-types --test tests/learning-core.test.mjs tests/sync.unit.mjs tests/native-store.unit.mjs tests/gist.unit.mjs",
    "build:android": "tsc -b && node scripts/build-mobile.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "mobile:preview": "vite preview --outDir dist-android --host 127.0.0.1",
    "test:mobile": "playwright test --config playwright.android.config.ts",
    "build:pages": "tsc -b && node scripts/build-mobile.mjs --pages",
    "preview:pages": "vite preview --mode pages --outDir dist-pages --host 127.0.0.1",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
